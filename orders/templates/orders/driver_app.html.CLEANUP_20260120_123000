{% extends "base.html" %}
{% load static %}
{% load money_filters %}

{% block title %}Mes courses – App livreur FAGNI{% endblock %}

{% block extra_head %}
<style>
  :root{
    --fagni-orange:#ff7a00;
    --fagni-blue:#0056b3;

    --bg:#ffffff;
    --text:#0f172a;
    --muted:#64748b;

    --line:#e5e7eb;
    --soft:#f3f4f6;
    --shadow: 0 1px 4px rgba(15,23,42,0.05);
    --shadow2: 0 10px 30px rgba(15,23,42,0.10);
  }

  .page{
    max-width:1050px;
    margin:0 auto 32px;
    padding:12px 10px 24px;
  }

  .page-header{
    display:flex;
    justify-content:space-between;
    align-items:flex-start;
    gap:12px;
    margin-bottom:18px;
  }

  .export-actions{
    display:flex;
    gap:8px;
    flex-wrap:wrap;
    justify-content:flex-end;
  }
  @media (max-width:960px){
    .export-actions{ justify-content:flex-start; }
  }

  .page-title{
    font-size:20px;
    font-weight:800;
    color:var(--text);
    margin:0;
    letter-spacing:-0.2px;
  }

  .page-subtitle{
    font-size:13px;
    color:var(--muted);
    margin:4px 0 0;
    line-height:1.35;
  }

  .page-header-right{
    text-align:right;
    display:flex;
    flex-direction:column;
    gap:6px;
    align-items:flex-end;
  }
  .page-header-right > * { margin-top: 6px; }
  .page-header-right > *:first-child { margin-top: 0; }

  .tag-driver{
    font-size:12px;
    background:#eff6ff;
    border-radius:999px;
    padding:4px 10px;
    color:#1d4ed8;
    border:1px solid #bfdbfe;
    display:inline-flex;
    align-items:center;
    gap:6px;
  }

  .columns{
    display:grid;
    grid-template-columns:repeat(3, minmax(0,1fr));
    gap:12px;
  }

  .column-title{
    font-size:13px;
    font-weight:800;
    margin:0 0 6px;
    display:flex;
    align-items:center;
    gap:8px;
    color:#111827;
    letter-spacing:-0.1px;
  }

  .column-title span.emoji{ font-size:16px; }

  .col-badge{
    margin-left:auto;
    display:inline-flex;
    align-items:center;
    gap:6px;
    padding:3px 9px;
    border-radius:999px;
    background:#f3f4f6;
    color:#374151;
    font-size:11px;
    border:1px solid #e5e7eb;
    font-weight:900;
  }

  .column-helper{
    font-size:11px;
    color:#6b7280;
    margin:0 0 10px;
  }

  /* =============================
     CARTE COURSE – FINITION UI
     ============================= */
  .card-course{
    background:var(--bg);
    border-radius:16px;
    padding:10px 10px;
    margin-bottom:8px;
    border:1px solid var(--line);
    box-shadow:var(--shadow);
    display:flex;
    flex-direction:column;
    gap:8px;
  }

  .card-course.is-clickable{
    cursor:pointer;
    transition: transform .12s ease, box-shadow .12s ease, border-color .12s ease;
  }
  .card-course.is-clickable:hover{
    transform: translateY(-1px);
    box-shadow: var(--shadow2);
    border-color: rgba(0,86,179,0.18);
  }
  .card-course.is-clickable:active{
    transform: translateY(0px);
    box-shadow: var(--shadow);
  }
  .card-course:focus-within{
    outline: 2px solid rgba(0,86,179,0.25);
    outline-offset: 2px;
  }

  .course-header{
    display:flex;
    justify-content:space-between;
    align-items:flex-start;
    gap:8px;
  }

  .course-code{
    font-size:13px;
    font-weight:800;
    color:#111827;
    letter-spacing:-0.1px;
  }

  .course-date{
    font-size:11px;
    color:#9ca3af;
    margin-top:2px;
  }

  .status-pill{
    padding:4px 10px;
    border-radius:999px;
    font-size:11px;
    display:inline-flex;
    align-items:center;
    gap:6px;
    white-space:nowrap;
    border:1px solid transparent;
    font-weight:700;
  }
  .status-pill .dot{
    width:7px;height:7px;border-radius:999px;display:inline-block;
  }

  .status-pending{
    background:#fffbeb;
    color:#92400e;
    border-color:#fde68a;
  }
  .status-pending .dot{ background:#f59e0b; }

  /* ✅ assigned = “prête à démarrer” (bleu) */
  .status-assigned{
    background:#e0f2fe;
    color:#075985;
    border-color:#bae6fd;
  }
  .status-assigned .dot{ background:#0284c7; }

  .status-in_progress{
    background:#dbeafe;
    color:#1d4ed8;
    border-color:#bfdbfe;
  }
  .status-in_progress .dot{ background:#2563eb; }

  .status-done{
    background:#ecfdf3;
    color:#166534;
    border-color:#bbf7d0;
  }
  .status-done .dot{ background:#16a34a; }

  /* Paiement */
  .pay-pill{
    padding:3px 9px;
    border-radius:999px;
    font-size:11px;
    display:inline-flex;
    align-items:center;
    gap:6px;
    border:1px solid transparent;
    font-weight:800;
    margin-top:6px;
    justify-content:flex-end;
  }
  .pay-pill .dot{ width:7px;height:7px;border-radius:999px;display:inline-block; }

  /* =============================
     BADGE REVENU (PAYÉ / ESTIMÉ)
     ============================= */
  .income-pill{
    padding:3px 9px;
    border-radius:999px;
    font-size:11px;
    display:inline-flex;
    align-items:center;
    gap:6px;
    border:1px solid transparent;
    font-weight:900;
  }

  .income-pill .dot{ width:7px;height:7px;border-radius:999px;display:inline-block; }

  .income-paid{
    background:#ecfdf3;
    color:#166534;
    border-color:#bbf7d0;
  }
  .income-paid .dot{ background:#16a34a; }

  .income-estimated{
    background:#eef2ff;
    color:#3730a3;
    border-color:#c7d2fe;
  }
  .income-estimated .dot{ background:#6366f1; }

  .income-partial{
    background:#fff7ed;
    color:#9a3412;
    border-color:#fed7aa;
  }
  .income-partial .dot{ background:#f97316; }

  .pay-paid{
    background:#ecfdf3;
    color:#166534;
    border-color:#bbf7d0;
  }
  .pay-paid .dot{ background:#16a34a; }

  .pay-due{
    background:#fff7ed;
    color:#9a3412;
    border-color:#fed7aa;
  }
  .pay-due .dot{ background:#f97316; }

  .pay-calc{
    background:#f3f4f6;
    color:#374151;
    border-color:#e5e7eb;
  }
  .pay-calc .dot{ background:#6b7280; }

  .course-body{
    font-size:12px;
    color:#374151;
  }

  .course-line{
    display:flex;
    justify-content:space-between;
    align-items:baseline;
    margin-top:2px;
    gap:10px;
  }

  .course-label{
    font-size:11px;
    color:#6b7280;
    white-space:nowrap;
  }

  .course-value{
    font-size:12px;
    color:#111827;
    font-weight:650;
    white-space:nowrap;
  }

  .amount-client{ font-weight:850; }
  .amount-driver{ color:#166534; font-weight:850; }
  .amount-due{ color:#9a3412; font-weight:900; }

  .course-footer{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-top:6px;
    gap:8px;
    flex-wrap:wrap;
  }

  .course-tags{
    display:flex;
    flex-wrap:wrap;
    gap:6px;
  }

  .tag-small{
    display:inline-flex;
    align-items:center;
    gap:6px;
    padding:3px 9px;
    border-radius:999px;
    background:#f3f4f6;
    color:#4b5563;
    font-size:11px;
    border:1px solid #e5e7eb;
  }

  /* =============================
     BOUTONS – UNIFORMISATION
     ============================= */
  .btn{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    padding:7px 12px;
    border-radius:999px;
    font-size:12px;
    border:1px solid transparent;
    cursor:pointer;
    text-decoration:none;
    white-space:nowrap;
    font-weight:800;
    transition: transform .12s ease, opacity .12s ease, background .12s ease, border-color .12s ease;
  }
  .btn:active{ transform: translateY(1px); }

  .btn-light{
    background:#fff;
    border:1px solid #e5e7eb;
    color:#374151;
  }
  .btn-light:hover{ background:#f9fafb; }

  .btn-primary{
    background:linear-gradient(90deg,var(--fagni-orange),var(--fagni-blue));
    color:#fff;
    border:none;
  }
  .btn-primary:hover{ opacity:0.97; }

  .empty{
    font-size:12px;
    color:#9ca3af;
    padding:6px 2px;
  }

  @media (max-width:960px){
    .columns{ grid-template-columns:1fr; }
    .page-header{ flex-direction:column; align-items:stretch; }
    .page-header-right{ align-items:flex-start; text-align:left; }
  }

  /* Wallet */
  .btn-wallet-link{
    display:inline-flex;
    align-items:center;
    gap:6px;
    padding:7px 12px;
    border-radius:999px;
    border:1px solid #e5e7eb;
    background:#ffffff;
    font-size:13px;
    color:#374151;
    text-decoration:none;
    box-shadow:0 1px 3px rgba(15,23,42,0.08);
    cursor:pointer;
    font-weight:800;
  }
  .btn-wallet-link:hover{ background:#f9fafb; }

  /* KPI LIVE */
  .kpi-header{ align-items:flex-start !important; gap:10px; }

  .kpi-meta{
    display:flex;
    flex-direction:column;
    align-items:flex-end;
    gap:6px;
    text-align:right;
  }

  .kpi-pill{
    display:inline-flex;
    align-items:center;
    padding:4px 10px;
    border-radius:999px;
    border:1px solid #e5e7eb;
    background:#f9fafb;
    font-size:11px;
    color:#374151;
    font-weight:800;
  }

  .kpi-sub{
    font-size:11px;
    color:#6b7280;
  }

  .kpi-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:10px 14px;
  }

  .kpi-item{
    display:flex;
    justify-content:space-between;
    align-items:baseline;
    gap:10px;
    padding:10px 12px;
    border:1px solid #eef2f7;
    border-radius:14px;
    background:#ffffff;
  }

  .kpi-wide{ grid-column:1 / -1; }

  .kpi-pulse{ animation:kpiPulse 280ms ease-out; }
  @keyframes kpiPulse{
    0%{ transform:translateY(0); opacity:0.65; }
    100%{ transform:translateY(0); opacity:1; }
  }
</style>
{% endblock %}

{% block content %}
<div class="page">

  <div class="page-header">

    <div>
      <h1 class="page-title">Mes courses</h1>
      <p class="page-subtitle">
        Vue livreur : suivez vos courses en attente, en cours et terminées.
        Ouvrez une course pour démarrer, terminer ou annuler l’itinéraire.
      </p>
    </div>

    <div class="card-course kpi-card" style="margin-bottom:12px;">
      <div class="course-header kpi-header">
        <div class="course-code">📊 Mes stats (live)</div>
        <div class="kpi-meta">
          <span class="kpi-pill" id="kpi-updated">Chargement…</span>
          <span class="kpi-sub" id="kpi-source">—</span>
        </div>
      </div>

      <div class="course-body kpi-grid">
        <div class="kpi-item">
          <span class="course-label">En attente</span>
          <span class="course-value" id="kpi-pending">—</span>
        </div>

        <div class="kpi-item">
          <span class="course-label">En cours</span>
          <span class="course-value" id="kpi-in-progress">—</span>
        </div>

        <div class="kpi-item">
          <span class="course-label">Terminées</span>
          <span class="course-value" id="kpi-done">—</span>
        </div>

        <div class="kpi-item">
          <span class="course-label">Distance totale</span>
          <span class="course-value" id="kpi-distance">—</span>
        </div>

        <div class="kpi-item kpi-wide">
          <span class="course-label">Mes gains (total)</span>
          <span class="course-value amount-driver" id="kpi-income">—</span>
        </div>
      </div>
    </div>

    <div class="page-header-right">

      {% if connected_driver %}
        <a href="{% url 'orders:driver_missions_history' %}?driver_id={{ connected_driver.id }}"
           class="btn-wallet-link">
          📜 Mes missions
        </a>

        <a href="{% url 'wallets:driver_wallet_dashboard' %}?driver_id={{ connected_driver.id }}"
           class="btn-wallet-link">
          💰 Mon wallet livreur
        </a>
      {% endif %}

      {% if request.user.is_staff %}
        <div class="export-actions">
          <a href="{% url 'orders:driver_app_export_csv' %}" class="btn btn-light js-export">
            ⬇️ Export CSV
          </a>
          <a href="{% url 'orders:driver_app_export_xlsx' %}" class="btn btn-primary js-export">
            ⬇️ Export XLSX
          </a>
        </div>
      {% endif %}

      {% if connected_driver %}
        <span class="tag-driver">
          🚴‍♂️ Livreur connecté :
          <strong>{{ connected_driver.name|default:"Profil livreur" }}</strong>
        </span>
      {% else %}
        <span class="text-muted" style="font-size:12px;">
          Connecte-toi en tant que livreur pour voir tes courses et ton wallet.
        </span>
      {% endif %}

    </div>

  </div>

  <div class="columns">

    <div class="column" data-status="pending">
      <h2 class="column-title">
        <span class="emoji">⏳</span> En attente
        <span class="col-badge" id="badge-pending">0</span>
      </h2>
      <p class="column-helper">Courses à venir ou à prendre en charge.</p>
      <div id="pending-list">
        <p class="empty">Chargement…</p>
      </div>
    </div>

    <div class="column" data-status="in_progress">
      <h2 class="column-title">
        <span class="emoji">🚚</span> En cours
        <span class="col-badge" id="badge-in-progress">0</span>
      </h2>
      <p class="column-helper">Courses actuellement en exécution.</p>
      <div id="in-progress-list">
        <p class="empty">Chargement…</p>
      </div>
    </div>

    <div class="column" data-status="done">
      <h2 class="column-title">
        <span class="emoji">✅</span> Terminées
        <span class="col-badge" id="badge-done">0</span>
      </h2>
      <p class="column-helper">Historique récent des courses achevées.</p>
      <div id="done-list">
        <p class="empty">Chargement…</p>
      </div>
    </div>

  </div>
</div>

<script>
(function(){
  const DATA_URL = "/orders/driver-app/data/" + (window.location.search || "");
  const refreshMs = 8000;

  const els = {
    kpiPending: document.getElementById("kpi-pending"),
    kpiInProgress: document.getElementById("kpi-in-progress"),
    kpiDone: document.getElementById("kpi-done"),
    kpiDistance: document.getElementById("kpi-distance"),
    kpiIncome: document.getElementById("kpi-income"),
    kpiSource: document.getElementById("kpi-source"),
    kpiUpdated: document.getElementById("kpi-updated"),

    badgePending: document.getElementById("badge-pending"),
    badgeInProgress: document.getElementById("badge-in-progress"),
    badgeDone: document.getElementById("badge-done"),

    listPending: document.getElementById("pending-list"),
    listInProgress: document.getElementById("in-progress-list"),
    listDone: document.getElementById("done-list"),
  };

  // ============================================================
  //  AUTO-HEAL COLUMNS (le DOM "strip" class/attrs -> on répare)
  // ============================================================
  function repairColumns(){
    const cols = document.querySelector(".columns");
    if(!cols) return false;

    const kids = [...cols.children].filter(n => n && n.nodeType === 1);

    const map = [
      { status:"pending",     sel:"#pending-list" },
      { status:"in_progress", sel:"#in-progress-list" },
      { status:"done",        sel:"#done-list" },
    ];

    let changed = false;

    kids.forEach((d, i) => {
      // Trouve le bon statut selon le contenu réel
      const found = map.find(x => d.querySelector(x.sel)) || map[i];
      const wantStatus = found?.status || null;

      // Réapplique class .column si absent
      if(!d.classList.contains("column")){
        d.classList.add("column");
        changed = true;
      }

      // Réapplique data-status si absent / différent
      if(wantStatus && d.getAttribute("data-status") !== wantStatus){
        d.setAttribute("data-status", wantStatus);
        changed = true;
      }
    });

    return changed;
  }

  function ensureAnimStyle(){
    if (document.getElementById("driver-app-anim-style")) return;
    const s = document.createElement("style");
    s.id = "driver-app-anim-style";
    s.textContent = `
      .card-course { will-change: transform, opacity; }
      .card-enter { opacity: 0; transform: translateY(8px); }
      .card-enter-active { opacity: 1; transform: translateY(0); transition: opacity 180ms ease, transform 180ms ease; }
      .card-exit { opacity: 1; transform: translateY(0); }
      .card-exit-active { opacity: 0; transform: translateY(-6px); transition: opacity 160ms ease, transform 160ms ease; }
    `;
    document.head.appendChild(s);
  }
  ensureAnimStyle();

  function escapeHtml(s){
    return String(s ?? "").replace(/[&<>"'`=\/]/g, function (c) {
      return ({
        "&":"&amp;",
        "<":"&lt;",
        ">":"&gt;",
        '"':"&quot;",
        "'":"&#39;",
        "`":"&#x60;",
        "=":"&#x3D;",
        "/":"&#x2F;"
      })[c];
    });
  }

  function money(n){
    try { return new Intl.NumberFormat("fr-FR").format(Number(n || 0)); }
    catch(e){ return String(n || 0); }
  }

  function timeNow(){
    const d = new Date();
    const hh = String(d.getHours()).padStart(2, "0");
    const mm = String(d.getMinutes()).padStart(2, "0");
    const ss = String(d.getSeconds()).padStart(2, "0");
    return `${hh}:${mm}:${ss}`;
  }

  function withQuery(url){
    const currentQs = new URLSearchParams(window.location.search || "");
    const currentDriverId = currentQs.get("driver_id") || "";

    const u = new URL(url, window.location.origin);
    const targetQs = new URLSearchParams(u.search || "");

    for (const [k, v] of currentQs.entries()){
      if (k === "driver_id") continue;
      targetQs.set(k, v);
    }

    if (currentDriverId){
      targetQs.set("driver_id", currentDriverId);
    } else {
      targetQs.delete("driver_id");
    }

    const qsStr = targetQs.toString();
    u.search = qsStr ? `?${qsStr}` : "";
    return u.pathname + u.search + u.hash;
  }

  function pulse(el){
    if(!el) return;
    el.classList.remove("kpi-pulse");
    void el.offsetWidth;
    el.classList.add("kpi-pulse");
  }

  function setText(el, value){
    if(!el) return;
    el.textContent = value;
    pulse(el);
  }

  function statusPill(status){
    if(status === "pending"){
      return `<span class="status-pill status-pending"><span class="dot"></span>En attente</span>`;
    }
    if(status === "assigned"){
      return `<span class="status-pill status-assigned"><span class="dot"></span>Assignée</span>`;
    }
    if(status === "in_progress"){
      return `<span class="status-pill status-in_progress"><span class="dot"></span>En cours</span>`;
    }
    if(status === "done"){
      return `<span class="status-pill status-done"><span class="dot"></span>Terminée</span>`;
    }
    return `<span class="status-pill"><span class="dot"></span>${escapeHtml(status || "—")}</span>`;
  }

  function payPill(label){
    if(label === "PAYÉ"){
      return `<span class="pay-pill pay-paid"><span class="dot"></span>PAYÉ</span>`;
    }
    if(label === "PARTIEL"){
      return `<span class="pay-pill pay-due"><span class="dot"></span>PARTIEL</span>`;
    }
    if(label === "À CALCULER"){
      return `<span class="pay-pill pay-calc"><span class="dot"></span>À CALCULER</span>`;
    }
    return `<span class="pay-pill pay-due"><span class="dot"></span>À ENCAISSER</span>`;
  }

  function incomePill(o){
    const paid = Number(o?.driver_income_paid ?? 0) || 0;
    const pot  = Number(o?.driver_income_potential ?? 0) || 0;

    // cas 1: payé partiel
    if (paid > 0 && pot > 0 && paid < pot){
      const tip = `PAYÉ PARTIEL (wallet) • payé=${money(paid)} • potentiel=${money(pot)}`;
      return `<span class="income-pill income-partial" title="${escapeHtml(tip)}"><span class="dot"></span>PAYÉ PARTIEL</span>`;
    }

    // cas 2: payé (wallet)
    if (paid > 0){
      const tip = `PAYÉ (wallet) • payé=${money(paid)} • potentiel=${money(pot)}`;
      return `<span class="income-pill income-paid" title="${escapeHtml(tip)}"><span class="dot"></span>PAYÉ</span>`;
    }

    // cas 3: estimé (legs)
    const tip = `ESTIMÉ (legs) • potentiel=${money(pot)} • payé=${money(paid)}`;
    return `<span class="income-pill income-estimated" title="${escapeHtml(tip)}"><span class="dot"></span>ESTIMÉ</span>`;
  }

  function ctaForStatus(status){
    if(status === "pending") return { label: "Démarrer →", cls: "btn-primary" };
    if(status === "assigned") return { label: "Démarrer →", cls: "btn-primary" };
    if(status === "in_progress") return { label: "Continuer →", cls: "btn-primary" };
    return { label: "Voir le détail →", cls: "btn-light" };
  }

  function pickNumber(o, keys){
    for(const k of keys){
      const v = o?.[k];
      if (v === null || v === undefined) continue;
      const n = Number(v);
      if (!isNaN(n)) return n;
    }

    function computeTotalClient(o){
      // 1) champs "officiels" si le backend les fournit
      const direct = pickNumber(o, ["total_client_ttc","total_client_display","total_client"]);
      if(direct !== null && isFinite(direct) && direct > 0) return direct;

      // 2) reconstruire depuis les morceaux (on teste plusieurs noms possibles)
      const services = pickNumber(o, [
        "services_total_ttc","items_total_ttc","subtotal_ttc","subtotal_services_ttc",
        "subtotal","sub_total","services_subtotal","items_subtotal"
      ]) || 0;

      const delivery = pickNumber(o, [
        "delivery_fee_client","delivery_fee","delivery_total","shipping_fee","transport_fee"
      ]) || 0;

      const serviceFee = pickNumber(o, [
        "service_fee","service_fee_client","platform_fee","fagni_fee"
      ]) || 0;

      const tva = pickNumber(o, [
        "tva","vat","tax","tax_amount"
      ]) || 0;

      const total = Number(services) + Number(delivery) + Number(serviceFee) + Number(tva);
      return (isFinite(total) && total > 0) ? total : null;
    }

    return null;
  }

  function cardHTML(o){
    const isCalc = (o.pay_label === "À CALCULER");

    const totalNum = pickNumber(o, ["total_client_ttc","total_client_display","total_client"]) ?? computeTotalClient(o);
    const totalSafe = (totalNum === null || isNaN(totalNum) || totalNum <= 0) ? null : totalNum;

    let due = pickNumber(o, ["due_amount","amount_due"]);
    if (due === null) {
    // si on a le payé, on calcule le reste = total - payé
    const paidClient = pickNumber(o, ["amount_paid","paid_amount","client_paid"]) || 0;
    if (totalSafe !== null && isFinite(totalSafe)) {
      due = Math.max(0, Number(totalSafe) - Number(paidClient));
    } else {
      due = (o.pay_label === "PAYÉ" || isCalc) ? 0 : 0;
    }
  }
  due = Number(due || 0);

    const totalHtml = isCalc || totalSafe === null
      ? `<span class="course-value amount-client">—</span>`
      : `<span class="course-value amount-client">${money(totalSafe)} FCFA</span>`;

    const dueHtml = (isCalc || o.pay_label === "PAYÉ" || due <= 0)
      ? `<span class="course-value">0 FCFA</span>`
      : `<span class="course-value amount-due">${money(due)} FCFA</span>`;

    const tags = [];
    const phone = escapeHtml(o.customer_phone || "");
    const addr = escapeHtml(o.customer_address || "");
    if(phone) tags.push(`<span class="tag-small">📞 ${phone}</span>`);
    if(addr) tags.push(`<span class="tag-small">📍 ${addr}</span>`);

    const created = o.created_at ? `Créée le ${escapeHtml(o.created_at)}` : "";
    const name = escapeHtml(o.customer_name || "Client");
    const code = escapeHtml(o.code || "");
    const detailUrlRaw = String(o.detail_url || "#");
    const detailUrlBase = withQuery(detailUrlRaw);
    const back = encodeURIComponent(window.location.pathname + window.location.search);
    const detailUrl = escapeHtml(detailUrlBase + (detailUrlBase.includes("?") ? "&" : "?") + "back=" + back);

    const distNum = Number(o.driver_distance || 0);
    const showDist = distNum > 0;

    const paidNum = Number(o?.driver_income_paid ?? 0) || 0;
    const potNum  = Number(o?.driver_income_potential ?? 0) || 0;

    // ✅ Affichage: payé si dispo, sinon potentiel
    const incomeNum = (paidNum > 0) ? paidNum : potNum;
    const cta = ctaForStatus(o.status);

    return `
      <div class="card-course is-clickable" data-href="${detailUrl}" data-order-id="${Number(o.id)}">
        <div class="course-header">
          <div>
            <div class="course-code">Course ${code}</div>
            <div class="course-date">${created}</div>
          </div>
          <div style="text-align:right;">
            ${statusPill(o.status)}
            ${payPill(o.pay_label)}
          </div>
        </div>

        <div class="course-body">
          <div class="course-line">
            <span class="course-label">Client</span>
            <span class="course-value">${name}</span>
          </div>

          <div class="course-line">
            <span class="course-label">Montant client</span>
            ${totalHtml}
          </div>

          <div class="course-line">
            <span class="course-label">À encaisser</span>
            ${dueHtml}
          </div>

          <div class="course-line">
            <span class="course-label">Mon revenu</span>
            <span class="course-value amount-driver" style="display:flex; align-items:center; gap:8px;">
              ${money(incomeNum)} FCFA
              ${incomePill(o)}
            </span>
          </div>

          ${showDist ? `
          <div class="course-line">
            <span class="course-label">Distance</span>
            <span class="course-value">${distNum.toFixed(2)} km</span>
          </div>
          ` : ``}
        </div>

        <div class="course-footer">
          <div class="course-tags">
            ${tags.join("")}
          </div>
          <a class="btn ${cta.cls}" href="${detailUrl}">${escapeHtml(cta.label)}</a>
        </div>
      </div>
    `;

  const colState = {
    pending: new Map(),
    in_progress: new Map(),
    done: new Map(),
  };

  function getCardEl(container, id){
    return container ? container.querySelector(`.card-course[data-order-id="${id}"]`) : null;
  }

  function animateIn(el){
    if(!el) return;
    el.classList.add("card-enter");
    requestAnimationFrame(() => {
      el.classList.add("card-enter-active");
      el.classList.remove("card-enter");
      setTimeout(() => { el.classList.remove("card-enter-active"); }, 220);
    });
  }

  function animateOutAndRemove(el){
    if(!el) return;
    el.classList.add("card-exit");
    requestAnimationFrame(() => {
      el.classList.add("card-exit-active");
      setTimeout(() => { el.remove(); }, 200);
    });
  }

  function renderEmptyIfNeeded(container, emptyText){
    if(!container) return;
    const hasCard = container.querySelector(".card-course");
    if(!hasCard){
      container.innerHTML = `<p class="empty">${escapeHtml(emptyText)}</p>`;
    } else {
      const empty = container.querySelector(".empty");
      if(empty) empty.remove();
    }
  }

  function applyColumn(container, items, emptyText, key){
    if(!container) return;

    const empty = container.querySelector(".empty");
    if(empty) empty.remove();

    const next = new Map();
    for(const o of (items || [])){
      const id = Number(o.id);
      next.set(id, cardHTML(o));
    }

    const prev = colState[key];

    for(const [id] of prev.entries()){
      if(!next.has(id)){
        const el = getCardEl(container, id);
        if(el) animateOutAndRemove(el);
        prev.delete(id);
      }
    }

    const frag = document.createDocumentFragment();
    for(const [id, html] of next.entries()){
      let el = getCardEl(container, id);

      if(!el){
        const tmp = document.createElement("div");
        tmp.innerHTML = html.trim();
        el = tmp.firstElementChild;
        if(el){
          animateIn(el);
          prev.set(id, html);
        }
      } else {
        const old = prev.get(id);
        if(old !== html){
          const tmp = document.createElement("div");
          tmp.innerHTML = html.trim();
          const fresh = tmp.firstElementChild;
          if(fresh){
            el.replaceWith(fresh);
            el = fresh;
            animateIn(el);
          }
          prev.set(id, html);
        }
      }

      if(el) frag.appendChild(el);
    }

    container.innerHTML = "";
    container.appendChild(frag);

    renderEmptyIfNeeded(container, emptyText);
  }

  let busy = false;

  function goLogin(nextUrl){
    const next = encodeURIComponent(nextUrl || (window.location.pathname + window.location.search));
    window.location.href = `/accounts/login/?next=${next}`;
  }

  document.querySelectorAll("a.js-export").forEach(a => {
    const href = a.getAttribute("href");
    if(href) a.setAttribute("href", withQuery(href));
  });

  async function refreshAll(){
    if(busy) return;
    busy = true;
    repairColumns();

    try{
      if(els.kpiSource) els.kpiSource.textContent = "Synchronisation…";

      const res = await fetch(DATA_URL, {
        method: "GET",
        credentials: "same-origin",
        headers: {
          "X-Requested-With": "XMLHttpRequest",
          "Accept": "application/json"
        },
        cache: "no-store",
        redirect: "follow"
      });

      if (res.status === 401 || res.status === 403) {
        goLogin(window.location.pathname + window.location.search);
        return;
      }
      if(!res.ok) throw new Error("bad_status_" + res.status);

      const ct = (res.headers.get("content-type") || "").toLowerCase();
      if(!ct.includes("application/json")) {
        goLogin(window.location.pathname + window.location.search);
        return;
      }

      const data = await res.json();

      const p = Number(data.pending ?? 0);
      const ip = Number(data.in_progress ?? 0);
      const d = Number(data.done ?? 0);

      setText(els.kpiPending, p);
      setText(els.kpiInProgress, ip);
      setText(els.kpiDone, d);

      setText(els.badgePending, p);
      setText(els.badgeInProgress, ip);
      setText(els.badgeDone, d);

      setText(els.kpiDistance, `${Number(data.total_distance_km ?? 0).toFixed(2)} km`);
      setText(els.kpiIncome, `${money(data.total_driver_income_display ?? data.total_driver_income ?? 0)} FCFA`);

      if(els.kpiSource){
        const sd = data.source_distance || "—";
        const si = data.source_income || "—";
        const paid = Number(data.total_driver_income_paid ?? 0);
        const pot = Number(data.total_driver_income_potential ?? 0);
        const hint = (paid > 0) ? `payé=${money(paid)} • potentiel=${money(pot)}` : `potentiel=${money(pot)} • payé=${money(paid)}`;
        els.kpiSource.textContent = `Source: distance=${sd} • revenu=${si} (${hint})`;
      }
      if(els.kpiUpdated){
        els.kpiUpdated.textContent = `Mis à jour à ${data.server_time || timeNow()}`;
      }

      repairColumns();

      applyColumn(els.listPending, data.orders_pending, "Aucune course en attente.", "pending");
      applyColumn(els.listInProgress, data.orders_in_progress, "Aucune course en cours.", "in_progress");
      applyColumn(els.listDone, data.orders_done, "Aucune course terminée récemment.", "done");

      const kpiCard = document.querySelector(".kpi-card");
      if(kpiCard){
        kpiCard.classList.remove("kpi-pulse");
        void kpiCard.offsetWidth;
        kpiCard.classList.add("kpi-pulse");
      }

    } catch(e){
      if(els.kpiSource) els.kpiSource.textContent = "Hors ligne / erreur sync";
      if(els.kpiUpdated) els.kpiUpdated.textContent = `Dernier essai ${timeNow()}`;
      console.error("driver_app refresh error:", e);
    } finally{
      busy = false;
    }
  }

  document.addEventListener("click", function(ev){
    const card = ev.target.closest(".card-course.is-clickable");
    if(!card) return;
    if(ev.target.closest("a, button, input, select, textarea, label")) return;
    const href = card.getAttribute("data-href");
    if(href) window.location.href = href;
  }, {passive:true});

  refreshAll();
  setInterval(refreshAll, refreshMs);
})();
</script>
{% endblock %}
