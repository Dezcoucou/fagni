{% extends "base.html" %}
{% load static %}
{% load l10n %}
{% load money_filters %}

{% block title %}Course {{ order.code|default:order.id }} – App livreur FAGNI{% endblock %}

{% block extra_head %}
<link rel="stylesheet" href="{% static 'vendor/leaflet/leaflet.css' %}">

<style>
    :root{
        --fagni-orange:#ff7a00;
        --fagni-blue:#0056b3;
        --bg-soft:#f5f5f7;
        --card-bg:#ffffff;
        --border-soft:#e5e7eb;
        --text-main:#111827;
        --text-muted:#6b7280;
        --shadow:0 2px 10px rgba(15,23,42,0.06);
        --shadow2:0 10px 30px rgba(15,23,42,0.14);
    }

    .page{
        max-width:1050px;
        margin:0 auto 32px;
        padding:12px 10px 24px;
    }

    /* Header premium */
    .hero{
        border-radius:18px;
        padding:14px 16px;
        margin-bottom:14px;
        background:linear-gradient(90deg, rgba(255,122,0,0.12), rgba(0,86,179,0.10));
        border:1px solid rgba(229,231,235,0.9);
        box-shadow:var(--shadow);
    }
    .hero-top{
        display:flex;
        justify-content:space-between;
        align-items:flex-start;
        gap:12px;
        flex-wrap:wrap;
    }
    .page-title{
        font-size:20px;
        font-weight:800;
        color:#0f172a;
        margin:0;
        letter-spacing:-0.01em;
    }
    .page-subtitle{
        font-size:13px;
        color:#475569;
        margin:4px 0 0;
    }
    .hero-meta{
        display:flex;
        gap:8px;
        align-items:center;
        flex-wrap:wrap;
        margin-top:8px;
    }

    .badge-status{
        display:inline-flex;
        align-items:center;
        gap:6px;
        padding:5px 10px;
        border-radius:999px;
        font-size:11px;
        font-weight:600;
        background:#fff;
        border:1px solid var(--border-soft);
        color:#0f172a;
        box-shadow:0 1px 3px rgba(15,23,42,0.05);
    }
    .badge-status.pending{ background:#fffbeb; border-color:#fde68a; color:#92400e; }
    .badge-status.in_progress{ background:#eff6ff; border-color:#bfdbfe; color:#1d4ed8; }
    .badge-status.done{ background:#ecfdf3; border-color:#bbf7d0; color:#166534; }
    .badge-status.canceled{ background:#fef2f2; border-color:#fecaca; color:#b91c1c; }

    .meta-small{
        font-size:11px;
        color:#64748b;
    }

    .hero-actions{
        display:flex;
        flex-wrap:wrap;
        gap:8px;
        justify-content:flex-end;
        align-items:flex-start;
    }

    /* Layout */
    .two-cols{
        display:grid;
        grid-template-columns:1.1fr 0.9fr;
        gap:14px;
        align-items:start;
    }

    @media (max-width: 980px){
        .two-cols{ grid-template-columns:1fr; }
    }

    /* Cards */
    .card{
        background:var(--card-bg);
        border-radius:16px;
        padding:14px 16px;
        margin-bottom:14px;
        border:1px solid var(--border-soft);
        box-shadow:var(--shadow);
    }
    .card-title{
        font-size:15px;
        font-weight:700;
        margin:0 0 10px;
        color:#0f172a;
        display:flex;
        align-items:center;
        gap:8px;
    }
    .card-title .emoji{ font-size:18px; }

    .label{
        font-size:11px;
        text-transform:uppercase;
        letter-spacing:0.04em;
        color:#94a3b8;
        margin-bottom:2px;
    }
    .value{ font-size:13px; color:var(--text-main); }
    .muted{ color:var(--text-muted); }

    .grid{
        display:grid;
        grid-template-columns:repeat(auto-fit, minmax(220px, 1fr));
        gap:10px 14px;
    }

    .divider{
        margin:10px 0;
        border-top:1px dashed #e5e7eb;
    }

    /* Buttons */
    .btn{
        display:inline-flex;
        align-items:center;
        justify-content:center;
        padding:7px 13px;
        border-radius:999px;
        font-size:13px;
        border:1px solid transparent;
        cursor:pointer;
        text-decoration:none;
        white-space:nowrap;
        gap:6px;
    }
    .btn-light{
        background:#fff;
        border-color:#e5e7eb;
        color:#374151;
    }
    .btn-light:hover{ background:#f9fafb; }
    .btn-soft{
        border-radius:999px;
        border:1px solid #e5e7eb;
        background:#ffffff;
        padding:6px 11px;
        font-size:12px;
        color:#374151;
        text-decoration:none;
        display:inline-flex;
        align-items:center;
        gap:6px;
        box-shadow:0 1px 3px rgba(15,23,42,0.05);
    }
    .btn-soft:hover{
        background:#f8fafc;
        border-color:#cbd5e1;
    }

    .btn-xxs{
        padding:6px 10px;
        font-size:11px;
        border-radius:999px;
        border:1px solid #e5e7eb;
        background:#fff;
        cursor:pointer;
    }
    .btn-xxs-primary{
        background:linear-gradient(90deg, var(--fagni-orange), var(--fagni-blue));
        border-color:transparent;
        color:#fff;
        box-shadow:0 2px 8px rgba(0,0,0,0.10);
    }
    .btn-xxs-primary:hover{ opacity:0.96; }
    .btn-xxs[disabled],
    .btn-xxs-primary[disabled]{
        opacity:0.55;
        cursor:not-allowed;
    }

    /* Right column sticky summary */
    .sticky{
        position:sticky;
        top:14px;
    }

    .summary{
        border-radius:18px;
        padding:14px 16px;
        border:1px solid rgba(255,255,255,0.10);
        background:
            radial-gradient(1200px 280px at 0% 0%, rgba(255,122,0,0.18), transparent 60%),
            radial-gradient(1000px 240px at 100% 0%, rgba(0,86,179,0.18), transparent 55%),
            linear-gradient(135deg, rgba(15,23,42,0.96), rgba(30,41,59,0.96));
        color:#e2e8f0;
        box-shadow:var(--shadow2);
        backdrop-filter: blur(6px);
    }
    .summary-title{
        display:flex;
        justify-content:space-between;
        align-items:center;
        gap:8px;
        margin-bottom:10px;
    }
    .summary-title strong{
        font-size:13px;
        letter-spacing:-0.01em;
    }
    .summary-kpi{
        display:grid;
        grid-template-columns:1fr 1fr;
        gap:10px;
    }
    .kpi-box{
        background:rgba(15,23,42,0.55);
        border:1px solid rgba(148,163,184,0.30);
        border-radius:14px;
        padding:10px 12px;
    }
    .kpi-box--wide{ grid-column:1 / -1; }

    .kpi-label{
        font-size:11px;
        opacity:0.85;
        margin-bottom:4px;
    }
    .kpi-value{
        font-size:16px;
        font-weight:800;
        color:#fff;
        line-height:1.1;
    }
    .kpi-sub{
        font-size:11px;
        opacity:0.9;
        margin-top:4px;
    }
    .kpi-accent{
        color:#fbbf24;
        font-weight:800;
    }

    /* KPI premium helpers (no inline styles) */
    .kpi-row{
        display:flex;
        align-items:baseline;
        gap:10px;
    }
    .kpi-unit{
        font-size:12px;
        opacity:.85;
        font-weight:700;
        letter-spacing:.02em;
    }
    .kpi-pill{
        margin-left:auto;
        font-size:11px;
        padding:3px 10px;
        border-radius:999px;
        background:rgba(255,122,0,.10);
        border:1px solid rgba(255,122,0,.25);
        color:#ffd08a;
        opacity:.95;
        font-weight:700;
    }
    .kpi-sub-row{
        display:flex;
        justify-content:space-between;
        gap:10px;
        align-items:center;
    }
    .kpi-stack{
        margin-top:8px;
        display:grid;
        gap:6px;
    }
    .kpi-strong{
        font-weight:800;
        color:#fff;
    }
    .kpi-strong-accent{
        font-weight:900;
        color:#fbbf24;
    }
    .kpi-progress{
        height:8px;
        border-radius:999px;
        background:rgba(255,255,255,.10);
        overflow:hidden;
        border:1px solid rgba(255,255,255,.12);
    }
    .kpi-progress > div{
        height:100%;
        width:0%;
        background:linear-gradient(90deg, rgba(255,122,0,.90), rgba(0,86,179,.60));
    }
    .kpi-hint{
        font-size:11px;
        opacity:.85;
    }
    .kpi-hint strong{
        color:#fff;
        font-weight:800;
    }

    /* Timeline */
    .timeline{ position:relative; margin-top:6px; }
    .timeline::before{
        content:"";
        position:absolute;
        top:4px;
        left:8px;
        width:2px;
        height:calc(100% - 4px);
        background:#e5e7eb;
    }
    .timeline-item{
        position:relative;
        padding-left:26px;
        margin-bottom:9px;
    }
    .timeline-bullet{
        position:absolute;
        left:2px;
        top:4px;
        width:12px;
        height:12px;
        border-radius:999px;
        background:#fff;
        border:2px solid #0f172a;
    }
    .timeline-title{
        font-size:13px;
        font-weight:600;
        color:#111827;
        margin:0;
    }
    .timeline-meta{
        font-size:11px;
        color:#6b7280;
        margin:2px 0 0;
    }

    /* Tables + photos */
    .articles-table-wrapper{
        width:100%;
        overflow-x:auto;
        border:1px solid #e5e7eb;
        border-radius:12px;
        margin-top:6px;
    }
    table{
        width:100%;
        border-collapse:collapse;
        font-size:13px;
        min-width:560px;
    }
    th, td{
        padding:8px 9px;
        border-bottom:1px solid #e5e7eb;
        text-align:left;
        vertical-align:top;
    }
    thead th{
        background:#f9fafb;
        font-weight:700;
        color:#64748b;
        font-size:12px;
    }
    .num{ text-align:right; white-space:nowrap; }
    .line-designation{ font-weight:600; }
    .line-meta{
        font-size:10px;
        color:#6b7280;
        margin-top:2px;
    }
    .photo-thumbs{
        display:flex;
        flex-wrap:wrap;
        gap:5px;
        margin-top:2px;
    }
    .photo-thumbs img{
        width:36px;
        height:36px;
        object-fit:cover;
        border-radius:8px;
        border:1px solid #e5e7eb;
        box-shadow:0 1px 3px rgba(15,23,42,0.05);
    }

    .notes-box{
        padding:10px 12px;
        border-radius:12px;
        background:#fffbeb;
        border:1px dashed #facc15;
        font-size:13px;
        color:#78350f;
        margin-top:8px;
        white-space:pre-wrap;
    }

    .photos-grid{
        display:flex;
        flex-wrap:wrap;
        gap:10px;
        margin-top:6px;
    }
    .photo-card{
        width:92px;
        font-size:11px;
        color:#4b5563;
        text-align:center;
    }
    .photo-card img{
        width:100%;
        height:72px;
        object-fit:cover;
        border-radius:10px;
        border:1px solid #e5e7eb;
        margin-bottom:4px;
        box-shadow:0 2px 6px rgba(15,23,42,0.06);
    }

    /* Legs */
    .legs-grid{
        display:grid;
        grid-template-columns:1fr;
        gap:8px;
        margin-top:6px;
    }
    .leg-card{
        border-radius:12px;
        border:1px solid #e5e7eb;
        padding:10px 12px;
        background:#f9fafb;
        font-size:12px;
    }
    .leg-title{ font-weight:800; margin-bottom:2px; }
    .leg-meta{ font-size:11px; color:#475569; }
    .leg-status-badge{
        display:inline-flex;
        align-items:center;
        gap:6px;
        padding:3px 10px;
        border-radius:999px;
        font-size:10px;
        margin-top:6px;
        border:1px solid rgba(229,231,235,0.9);
        background:#fff;
    }
    .leg-status-pending{ background:#fffbeb; color:#92400e; border-color:#fde68a; }
    .leg-status-assigned{ background:#e0f2fe; color:#075985; border-color:#bae6fd; }
    .leg-status-in_progress{ background:#eff6ff; color:#1d4ed8; border-color:#bfdbfe; }
    .leg-status-done{ background:#ecfdf3; color:#166534; border-color:#bbf7d0; }
    .leg-status-canceled{ background:#fef2f2; color:#b91c1c; border-color:#fecaca; }

    /* Action rows */
    .leg-actions-row{
        display:flex;
        justify-content:space-between;
        align-items:flex-start;
        gap:10px;
        margin-bottom:10px;
        padding-bottom:10px;
        border-bottom:1px dashed #e5e7eb;
    }
    .leg-actions-row:last-child{ border-bottom:none; margin-bottom:0; padding-bottom:0; }
    .leg-actions-left{
        font-size:12px;
        color:#111827;
        line-height:1.35;
        max-width:60%;
    }
    .leg-actions-buttons{
        display:flex;
        flex-wrap:wrap;
        gap:6px;
        justify-content:flex-end;
        align-items:center;
    }
    .callout{
        font-size:11px;
        color:#475569;
        background:#f8fafc;
        border:1px solid #e2e8f0;
        padding:8px 10px;
        border-radius:12px;
        max-width:320px;
        text-align:right;
    }

    .actions-footer{
        margin-top:18px;
        display:flex;
        gap:10px;
        justify-content:flex-end;
        flex-wrap:wrap;
    }

    /* ====== MAP (Lot 2.1) ====== */
    .map-shell{
        border-radius:14px;
        overflow:hidden;
        border:1px solid #e5e7eb;
        background:#f8fafc;
        position:relative;
    }
    #fagniMap{
        width:100%;
        height:280px;
        display:block;
    }
    .map-hint{
        font-size:12px;
        color:#6b7280;
        margin-top:8px;
        line-height:1.4;
    }
    .map-empty{
        padding:12px;
        border-radius:12px;
        border:1px dashed #e5e7eb;
        background:#fff;
        color:#6b7280;
        font-size:12px;
    }

    /* ✅ overlay loading */
    .map-loading{
        position:absolute;
        inset:0;
        display:flex;
        align-items:center;
        justify-content:center;
        font-size:12px;
        color:#475569;
        background:rgba(248,250,252,0.88);
        backdrop-filter: blur(2px);
        z-index:500;
        text-align:center;
        padding:10px;
    }
    .map-loading.hidden{ display:none; }

    @media (max-width: 900px){
        table{ min-width:0; }
        .leg-actions-left{ max-width:100%; }
        #fagniMap{ height:240px; }
    }

    .map-controls{
        display:flex;
        flex-wrap:wrap;
        gap:8px;
        align-items:center;
        margin-top:10px;
    }
    .geo-status{
        font-size:12px;
        color:#64748b;
        background:#fff;
        border:1px solid #e5e7eb;
        padding:6px 10px;
        border-radius:999px;
    }
    .geo-info{
        margin-top:10px;
        font-size:12px;
        color:#0f172a;
        background:#f8fafc;
        border:1px solid #e2e8f0;
        padding:10px 12px;
        border-radius:12px;
        line-height:1.4;
    }

    /* ✅ Toast live */
    .toast{
        position:fixed;
        left:12px;
        right:12px;
        bottom:14px;
        z-index:9999;
        display:none;
        padding:10px 12px;
        border-radius:14px;
        border:1px solid rgba(229,231,235,0.9);
        background:rgba(15,23,42,0.92);
        color:#e2e8f0;
        box-shadow:0 10px 30px rgba(0,0,0,0.20);
        max-width:560px;
        margin:0 auto;
        font-size:12px;
        line-height:1.35;
    }
    .toast strong{ color:#fff; }

    /* PAY PILL */
    .pill-soft{display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:999px;font-size:12px;font-weight:800;border:1px solid rgba(255,255,255,.08)}
    .pill-paid{background:#ecfdf3;color:#166534;border-color:#bbf7d0}
    .pill-partial{background:#fffbeb;color:#92400e;border-color:#fde68a}
    .pill-unpaid{background:#fef2f2;color:#991b1b;border-color:#fecaca}

</style>
{% endblock %}

{% block content %}
<div class="page"
     data-order-id="{{ order.id }}"
     data-live-url="{% url 'orders:driver_order_live' order.id %}{% if driver %}?driver_id={{ driver.id }}{% endif %}"
     data-leg-action-base="/orders/drivers/app/leg/"
     data-pickup-lat="{{ pickup_lat|default_if_none:''|unlocalize }}"
     data-pickup-lng="{{ pickup_lng|default_if_none:''|unlocalize }}"
     data-delivery-lat="{{ delivery_lat|default_if_none:''|unlocalize }}"
     data-delivery-lng="{{ delivery_lng|default_if_none:''|unlocalize }}"
     data-laundry-lat="{{ provider_lat|default_if_none:''|unlocalize }}"
     data-laundry-lng="{{ provider_lng|default_if_none:''|unlocalize }}"
>
    <div id="liveToast" class="toast"></div>

    <!-- HERO HEADER -->
    <div class="hero">
        <div class="hero-top">
            <div>
                <h1 class="page-title">Course {{ order.code|default:order.id }}</h1>
                <p class="page-subtitle">Vue chauffeur – ce qui te concerne (trajet, montant, étapes, actions).</p>

                <div class="hero-meta">
                    {% with s=order.status %}
                        <span id="orderStatusBadge" class="badge-status {{ s }}">
                            {% if s == "pending" %}⏳ En attente
                            {% elif s == "in_progress" %}🚦 En cours
                            {% elif s == "done" %}✅ Terminée
                            {% elif s == "canceled" %}❌ Annulée
                            {% else %}📦 {{ order.get_status_display }}
                            {% endif %}
                        </span>
                    {% endwith %}
                    <span class="meta-small">Créée le {{ order.created_at|date:"d/m/Y H:i" }}</span>
                </div>

                <div style="margin-top:10px; display:flex; flex-wrap:wrap; gap:8px;">
                    {% if order.customer and order.customer.phone %}
                        <a class="btn-soft" href="tel:{{ order.customer.phone }}">📞 Appeler client</a>
                    {% endif %}

                    {% with pickup=order.pickup_address|default:order.customer.address %}
                        {% if pickup %}
                            <a class="btn-soft" target="_blank"
                               href="https://www.google.com/maps/search/?api=1&query={{ pickup|urlencode }}">
                                🗺️ Maps collecte
                            </a>
                        {% endif %}
                    {% endwith %}

                    {% if order.laundry_partner %}
                        {% with laund=order.laundry_partner %}
                            {% if laund.latitude and laund.longitude %}
                                <a class="btn-soft" target="_blank"
                                   href="https://www.google.com/maps?q={{ laund.latitude }},{{ laund.longitude }}">
                                    🧺🗺️ Maps prestataire
                                </a>
                            {% elif laund.address %}
                                <a class="btn-soft" target="_blank"
                                   href="https://www.google.com/maps/search/?api=1&query={{ laund.address|urlencode }}">
                                    🧺🗺️ Maps prestataire
                                </a>
                            {% else %}
                                <a class="btn-soft" target="_blank"
                                   href="https://www.google.com/maps/search/?api=1&query={{ laund.name|urlencode }}">
                                    🧺🗺️ Maps prestataire
                                </a>
                            {% endif %}
                        {% endwith %}
                    {% endif %}

                    {% if order.delivery_address %}
                        <a class="btn-soft" target="_blank"
                           href="https://www.google.com/maps/search/?api=1&query={{ order.delivery_address|urlencode }}">
                            📦🗺️ Maps livraison
                        </a>
                    {% endif %}
                </div>
            </div>

            <div class="hero-actions">
                {% with back=request.GET.back %}
                    {% if back and back|slice:":7" == "/orders/" %}
                        <a href="{{ back }}" class="btn btn-light">← Retour à mes courses</a>
                    {% else %}
                        {% with did=request.GET.driver_id|default:order.delivery_partner_id %}
                            <a href="{% url 'orders:driver_app' %}{% if did %}?driver_id={{ did }}{% elif request.GET.urlencode %}?{{ request.GET.urlencode }}{% endif %}" class="btn btn-light">
                                ← Retour à mes courses
                            </a>
                        {% endwith %}
                    {% endif %}
                {% endwith %}

                {% if driver_wallet_url %}
                    <a href="{{ driver_wallet_url }}" class="btn-soft" target="_blank">🚴💳 Mon wallet livreur</a>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="two-cols">
        <!-- LEFT -->
        <div>
            <section class="card">
                <h2 class="card-title"><span class="emoji">👤</span> Client & adresses</h2>

                <div class="grid">
                    <div>
                        <div class="label">Nom</div>
                        <div class="value">{{ order.customer.name|default:"—" }}</div>
                    </div>
                    <div>
                        <div class="label">Téléphone</div>
                        <div class="value">{{ order.customer.phone|default:"—" }}</div>
                    </div>
                    <div>
                        <div class="label">Adresse de collecte</div>
                        <div class="value">{{ order.pickup_address|default:order.customer.address|default:"—" }}</div>
                    </div>
                    <div>
                        <div class="label">Adresse de livraison</div>
                        <div class="value">{{ order.delivery_address|default:order.pickup_address|default:order.customer.address|default:"—" }}</div>
                    </div>
                </div>

                {% if order.laundry_partner %}
                    <div class="divider"></div>
                    {% with laund=order.laundry_partner %}
                        <div class="label">Prestataire</div>
                        <div class="value">
                            <strong>{{ laund.name|default:"—" }}</strong>
                            {% if laund.city %}<br><span class="muted">📍 {{ laund.city }}</span>{% endif %}
                            {% if laund.address %}<br><span class="muted">{{ laund.address }}</span>{% endif %}
                            {% if laund.phone %}<br><span class="muted">☎ {{ laund.phone }}</span>{% endif %}
                            {% if laund.email %}<br><span class="muted">✉ {{ laund.email }}</span>{% endif %}
