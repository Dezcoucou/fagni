<script>
(function () {
  "use strict";

  // ==========================================
  // Helpers
  // ==========================================
  function toNum(v) {
    if (v === null || v === undefined) return null;
    v = ("" + v).trim();
    if (!v) return null;
    var n = Number(v);
    return isFinite(n) ? n : null;
  }

  function fmtKm(km) {
    if (km === null || km === undefined || !isFinite(km)) return "—";
    if (km < 1) return Math.round(km * 1000) + " m";
    return km.toFixed(2) + " km";
  }

  function haversineKm(lat1, lng1, lat2, lng2) {
    function toRad(x) { return (x * Math.PI) / 180; }
    var R = 6371;
    var dLat = toRad(lat2 - lat1);
    var dLng = toRad(lng2 - lng1);
    var a =
      Math.sin(dLat / 2) * Math.sin(dLat / 2) +
      Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) *
      Math.sin(dLng / 2) * Math.sin(dLng / 2);
    var c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
    return R * c;
  }

  // CSRF Django
  function getCookie(name) {
    var cookieValue = null;
    if (document.cookie && document.cookie !== "") {
      var cookies = document.cookie.split(";");
      for (var i = 0; i < cookies.length; i++) {
        var cookie = cookies[i].trim();
        if (cookie.substring(0, name.length + 1) === (name + "=")) {
          cookieValue = decodeURIComponent(cookie.substring(name.length + 1));
          break;
        }
      }
    }
    return cookieValue;
  }
  var CSRFTOKEN = getCookie("csrftoken");

  function postForm(url, dataObj) {
    var body = new URLSearchParams();
    Object.keys(dataObj || {}).forEach(function (k) {
      if (dataObj[k] !== undefined && dataObj[k] !== null) body.append(k, dataObj[k]);
    });

    return fetch(url, {
      method: "POST",
      headers: {
        "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8",
        "X-CSRFToken": CSRFTOKEN || ""
      },
      body: body.toString(),
      credentials: "same-origin"
    }).then(function (r) {
      return r.json().catch(function () { return {}; }).then(function (j) {
        if (!r.ok) {
          var err = (j && (j.error || j.detail)) ? (j.error || j.detail) : ("HTTP " + r.status);
          throw new Error(err);
        }
        return j;
      });
    });
  }

  function fmtXof(n){
    n = Number(n || 0);
    try { return new Intl.NumberFormat("fr-FR").format(Math.round(n)); }
    catch(e){ return String(Math.round(n)); }
  }

  // ==========================================
  // DOM
  // ==========================================
  var page = document.querySelector(".page");
  if (!page) return;

  var mapEl = document.getElementById("fagniMap");
  var emptyEl = document.getElementById("mapEmpty");
  var infoEl = document.getElementById("geoInfo");
  var statusEl = document.getElementById("geoStatus");

  var loadingEl = document.getElementById("mapLoading");
  function showLoading(msg){
    if (!loadingEl) return;
    loadingEl.classList.remove("hidden");
    loadingEl.textContent = msg || "⏳ Chargement de la carte…";
  }
  function hideLoading(){
    if (!loadingEl) return;
    loadingEl.classList.add("hidden");
  }

  function setInfo(html) {
    if (!infoEl) return;
    infoEl.style.display = html ? "block" : "none";
    infoEl.innerHTML = html || "";
  }

  function setStatus(txt) {
    if (!statusEl) return;
    statusEl.textContent = txt || "";
  }

  var btnLocateOnce = document.getElementById("btnLocateOnce");
  var btnStartWatch = document.getElementById("btnStartWatch");
  var btnStopWatch  = document.getElementById("btnStopWatch");

  // ==========================================
  // Data points
  // ==========================================
  var pickupLat   = toNum(page.dataset.pickupLat);
  var pickupLng   = toNum(page.dataset.pickupLng);
  var deliveryLat = toNum(page.dataset.deliveryLat);
  var deliveryLng = toNum(page.dataset.deliveryLng);
  var laundryLat  = toNum(page.dataset.laundryLat);
  var laundryLng  = toNum(page.dataset.laundryLng);

  var points = [];
  if (pickupLat !== null && pickupLng !== null) {
    points.push({ k: "pickup", lat: pickupLat, lng: pickupLng, label: "Collecte (client)" });
  }
  if (laundryLat !== null && laundryLng !== null) {
    points.push({ k: "laundry", lat: laundryLat, lng: laundryLng, label: "Prestataire" });
  }
  if (deliveryLat !== null && deliveryLng !== null) {
    points.push({ k: "delivery", lat: deliveryLat, lng: deliveryLng, label: "Livraison (client)" });
  }

  if (!mapEl) return;

  if (points.length === 0) {
    mapEl.style.display = "none";
    if (emptyEl) emptyEl.style.display = "block";
    hideLoading();
    return;
  } else {
    if (emptyEl) emptyEl.style.display = "none";
    mapEl.style.display = "block";
  }

  // ==========================================
  // Map init
  // ==========================================
  if (!window.L) {
    showLoading("⚠️ Leaflet non chargé.");
    return;
  }

  showLoading("⏳ Chargement de la carte…");

  var center = [points[0].lat, points[0].lng];
  var map = L.map("fagniMap", { zoomControl: true }).setView(center, 13);

  var tiles = L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
    maxZoom: 19,
    attribution: "&copy; OpenStreetMap"
  }).addTo(map);

  tiles.once("tileload", function(){ hideLoading(); });
  tiles.once("load", function(){ hideLoading(); });

  tiles.on("tileerror", function(){
    showLoading("⚠️ Carte indisponible (réseau/tiles). Utilise les boutons Google Maps.");
  });

  var fagniIcon = L.icon({
    iconRetinaUrl: "{% static 'vendor/leaflet/images/marker-icon-2x.png' %}",
    iconUrl: "{% static 'vendor/leaflet/images/marker-icon.png' %}",
    shadowUrl: "{% static 'vendor/leaflet/images/marker-shadow.png' %}",
    iconSize: [25, 41],
    iconAnchor: [12, 41],
    popupAnchor: [1, -34],
    shadowSize: [41, 41]
  });

  var bounds = L.latLngBounds([]);

  points.forEach(function (p) {
    L.marker([p.lat, p.lng], { icon: fagniIcon }).addTo(map).bindPopup(p.label);
    bounds.extend([p.lat, p.lng]);
  });

  if (points.length >= 2) {
    var poly = L.polyline(points.map(function (p) { return [p.lat, p.lng]; }), {
      weight: 4,
      opacity: 0.85
    }).addTo(map);
    bounds = bounds.extend(poly.getBounds());

    try {
      map.fitBounds(bounds, { padding: [20, 20] });
    } catch (e) {
      map.setView(center, 13);
    }
  } else {
    map.setView(center, 15);
  }

  setTimeout(function () { map.invalidateSize(true); }, 650);

  window.addEventListener("resize", function(){ setTimeout(function(){ map.invalidateSize(true); }, 250); });
  window.addEventListener("orientationchange", function(){ setTimeout(function(){ map.invalidateSize(true); }, 450); });

  // ==========================================
  // GEO + Server sync (Lot 4.5)
  // ==========================================
  var watchId = null;
  var lastDriverPos = null;

  var UPDATE_URL = "{% url 'orders:driver_update_location' %}";
  var SEND_INTERVAL_MS = 8000;
  var lastSentAt = 0;

  function safeSendToServer(lat, lng) {
    var now = Date.now();
    if (now - lastSentAt < SEND_INTERVAL_MS) return Promise.resolve({ skipped: true });
    lastSentAt = now;

    return postForm(UPDATE_URL, { lat: lat, lng: lng })
      .then(function () { return { ok: true }; })
      .catch(function (e) {
        console.warn("GPS sync error:", e && e.message ? e.message : e);
        return { ok: false, error: (e && e.message) ? e.message : "Erreur envoi GPS" };
      });
  }

  function updateDistances(driverLat, driverLng) {
    var rows = points
      .map(function (p) { return { label: p.label, km: haversineKm(driverLat, driverLng, p.lat, p.lng) }; })
      .sort(function (a, b) { return a.km - b.km; });

    var next = rows[0];
    var html =
      "<strong>📍 Position détectée</strong><br>" +
      "Prochaine étape : <strong>" + next.label + "</strong> (" + fmtKm(next.km) + ")<br><br>" +
      rows.map(function (r) { return "• " + r.label + " : " + fmtKm(r.km); }).join("<br>");

    setInfo(html);
  }

  function updateNextStepUI() {
    var elLabel = document.getElementById("nextStepLabel");
    var elDist  = document.getElementById("nextStepDistance");
    if (!elLabel || !elDist) return;

    if (!lastDriverPos) {
      elLabel.textContent = "—";
      elDist.textContent  = "Distance restante : —";
      return;
    }

    var rows = points
      .map(function (p) { return { label: p.label, km: haversineKm(lastDriverPos.lat, lastDriverPos.lng, p.lat, p.lng) }; })
      .sort(function (a, b) { return a.km - b.km; });

    var next = rows[0];
    elLabel.textContent = next.label;
    elDist.textContent  = "Distance restante : " + fmtKm(next.km);
  }

  function placeOrMoveDriver(lat, lng, accuracy) {
    lastDriverPos = { lat: lat, lng: lng };
    setStatus("GPS : OK" + (accuracy ? (" (±" + Math.round(accuracy) + "m)") : ""));
    updateDistances(lat, lng);
    updateNextStepUI();
    safeSendToServer(lat, lng);
  }

  function geoError(err) {
    var msg = "GPS : erreur";
    if (err && err.code === 1) msg = "GPS : permission refusée";
    if (err && err.code === 2) msg = "GPS : position indisponible";
    if (err && err.code === 3) msg = "GPS : timeout";
    setStatus(msg);

    setInfo("⚠️ La géolocalisation nécessite souvent <strong>HTTPS</strong> (ou localhost).<br>Active le GPS et autorise le navigateur.");
    updateNextStepUI();
  }

  function locateOnce() {
    if (!navigator.geolocation) {
      setStatus("GPS : non supporté");
      setInfo("⚠️ Ce navigateur ne supporte pas la géolocalisation.");
      return;
    }

    setStatus("GPS : recherche…");
    navigator.geolocation.getCurrentPosition(function (pos) {
      var lat = pos.coords.latitude;
      var lng = pos.coords.longitude;
      var acc = pos.coords.accuracy;

      placeOrMoveDriver(lat, lng, acc);
      map.setView([lat, lng], 15);
      setTimeout(function () { map.invalidateSize(true); }, 350);
    }, geoError, { enableHighAccuracy: true, timeout: 12000, maximumAge: 0 });
  }

  function startWatch() {
    if (!navigator.geolocation) {
      setStatus("GPS : non supporté");
      return;
    }
    if (watchId) return;

    setStatus("GPS : suivi live…");
    if (btnStopWatch) btnStopWatch.style.display = "inline-flex";

    watchId = navigator.geolocation.watchPosition(function (pos) {
      var lat = pos.coords.latitude;
      var lng = pos.coords.longitude;
      var acc = pos.coords.accuracy;
      placeOrMoveDriver(lat, lng, acc);
    }, geoError, { enableHighAccuracy: true, timeout: 15000, maximumAge: 2000 });
  }

  function stopWatch() {
    if (watchId && navigator.geolocation) {
      navigator.geolocation.clearWatch(watchId);
      watchId = null;
    }
    setStatus("GPS : arrêté");
    if (btnStopWatch) btnStopWatch.style.display = "none";
  }

  if (btnLocateOnce) btnLocateOnce.addEventListener("click", locateOnce);
  if (btnStartWatch) btnStartWatch.addEventListener("click", startWatch);
  if (btnStopWatch)  btnStopWatch.addEventListener("click", stopWatch);

  // ==========================================
  // LIVE REFRESH (Lot 4.4) — sans reload
  // ==========================================
  var liveUrl = page.dataset.liveUrl;

  function statusLabel(s){
    if (s === "pending") return "⏳ En attente";
    if (s === "assigned") return "📌 Assignée";
    if (s === "in_progress") return "🚴 En cours";
    if (s === "done") return "✅ Terminée";
    if (s === "canceled") return "❌ Annulée";
    return s || "—";
  }

  function showToast(html){
    var t = document.getElementById("liveToast");
    if (!t) return;
    t.innerHTML = html;
    t.style.display = "block";
    clearTimeout(showToast._tm);
    showToast._tm = setTimeout(function(){ t.style.display = "none"; }, 2500);
  }

  function setOrderBadge(status){
    var b = document.getElementById("orderStatusBadge");
    if (!b) return;
    b.className = "badge-status " + (status || "");
    b.textContent = (status === "pending") ? "⏳ En attente"
      : (status === "in_progress") ? "🚦 En cours"
      : (status === "done") ? "✅ Terminée"
      : (status === "canceled") ? "❌ Annulée"
      : ("📦 " + (status || "—"));
  }

  function setLegBadge(card, status){
    var badge = card.querySelector(".js-leg-status-badge");
    var txt   = card.querySelector(".js-leg-status-text");
    if (badge){
      badge.className = "leg-status-badge js-leg-status-badge leg-status-" + (status || "");
    }
    if (txt){
      txt.textContent = statusLabel(status);
    }
  }
  
  function setTime(wrapId, textId, value){
    // Si tu as des wrappers (ex: <div id="tlPickupWrap">...</div>)
    // on les affiche/masque proprement.
    var wrap = wrapId ? document.getElementById(wrapId) : null;
    var el   = textId ? document.getElementById(textId) : null;

    if (!el && !wrap) return;

    if (value){
      if (el) el.textContent = value;
      if (wrap) wrap.style.display = "";
    } else {
      // si pas de valeur, on masque le bloc si wrapper existe
      if (wrap) wrap.style.display = "none";
    }
  }

  function applyLive(payload){
    if (!payload || !payload.ok) return;

    // --- Order badge ---
    setOrderBadge(payload.order && payload.order.status);

    // --- Legs grid ---
    var mapById = {};
    (payload.legs || []).forEach(function(l){ mapById[String(l.id)] = l; });

    document.querySelectorAll("#legsGrid .leg-card[data-leg-id]").forEach(function(card){
      var id = card.getAttribute("data-leg-id");
      var leg = mapById[String(id)];
      if (!leg) return;

      var dEl = card.querySelector(".js-leg-distance");
      if (dEl) dEl.textContent = (leg.distance_km || 0).toFixed(2);

      var aEl = card.querySelector(".js-leg-amount");
      if (aEl) aEl.textContent = String(Math.round(leg.driver_amount || 0));

      setLegBadge(card, leg.status);
    });

    // -------- Timeline live --------
    if (payload.order_times){
      var t = payload.order_times;

      // Version “simple” : si tu as juste des <p id="tl_pickup">...</p>
      var elPickup = document.getElementById("tl_pickup");
      if (elPickup && t.pickup_time) elPickup.textContent = t.pickup_time;

      var elDropoff = document.getElementById("tl_dropoff");
      if (elDropoff && t.dropoff_time) elDropoff.textContent = t.dropoff_time;

      var elWash = document.getElementById("tl_wash_complete");
      if (elWash && t.wash_complete_time) elWash.textContent = t.wash_complete_time;

      var elReturn = document.getElementById("tl_return");
      if (elReturn && t.return_time) elReturn.textContent = t.return_time;

      var elDelivered = document.getElementById("tl_delivered");
      if (elDelivered && t.delivered_time) elDelivered.textContent = t.delivered_time;

      // Version “premium” : si tu as aussi des wrappers tlPickupWrap etc.
      // (si tu ne les as pas, ça ne fera rien)
      setTime("tlPickupWrap","tl_pickup", t.pickup_time);
      setTime("tlDropoffWrap","tl_dropoff", t.dropoff_time);
      setTime("tlWashWrap","tl_wash_complete", t.wash_complete_time);
      setTime("tlReturnWrap","tl_return", t.return_time);
      setTime("tlDeliveredWrap","tl_delivered", t.delivered_time);
    }

    // -------- KPI live --------
    if (payload.kpi){
      var elIncome = document.getElementById("kpiDriverIncome");
      var elPct = document.getElementById("kpiDriverIncomePct");
      var elPot = document.getElementById("kpiDriverPotential");
      var elRem = document.getElementById("kpiDriverRemaining");
      var elBar = document.getElementById("kpiDriverBar");

      function clamp0(x){ x = Number(x || 0); return (x < 0) ? 0 : x; }

      var inc = clamp0(payload.kpi.driver_income);
      var pct = clamp0(payload.kpi.driver_income_progress_pct);
      if (pct > 100) pct = 100;

      if (elIncome) elIncome.textContent = fmtXof(inc);
      if (elPct) elPct.textContent = (pct || 0) + "%";

      if (elPot) elPot.textContent = fmtXof(payload.kpi.driver_leg_amount_all) + " FCFA"; 
      if (elRem) elRem.textContent = fmtXof(clamp0(payload.kpi.driver_income_remaining)) + " FCFA";
      if (elBar) elBar.style.width = (pct || 0) + "%";
    }
  }

  var _lastKey = null;
  function pollLive(){
    if (!liveUrl) return;
    fetch(liveUrl, { credentials: "same-origin" })
      .then(function(r){ return r.json(); })
      .then(function(j){
        var key = JSON.stringify((j.legs||[]).map(function(l){ return [l.id,l.status]; }));
        if (_lastKey && key !== _lastKey){
          showToast("<strong>✅ Mise à jour</strong><br>Statuts rafraîchis.");
        }
        _lastKey = key;
        applyLive(j);
      })
      .catch(function(){});
  }

  setInterval(pollLive, 6000);
  setTimeout(pollLive, 800);

  updateNextStepUI();
  setStatus("GPS : prêt");

})();
</script>
{% endblock %}
