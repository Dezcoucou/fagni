/* ============================================================
   FAGNI DESIGN SYSTEM — GLOBAL THEME
   ============================================================ */

:root {
    --fagni-primary: #F07C22;          /* Orange FAGNI */
    --fagni-primary-soft: #fcd8b6;
    --fagni-primary-hover: #d96815;

    --fagni-navy: #173B63;             /* Bleu profond */
    --fagni-navy-light: #3b5c85;

    --fagni-bg: #f4f7fb;               /* Background global */
    --fagni-surface: #ffffff;          /* Cartes, surfaces */
    --fagni-border: #e2e8f0;           /* Gris neutre */
    --fagni-border-strong: #cbd5e1;

    --fagni-text: #0f172a;             /* Texte principal */
    --fagni-text-soft: #64748b;        /* Texte secondaire */
    --fagni-muted: #94a3b8;            /* Texte discret */

    --fagni-success: #16a34a;          /* Vert réussite */
    --fagni-warning: #fbbf24;          /* Jaune */
    --fagni-danger: #dc2626;           /* Rouge */

    --fagni-radius-sm: 6px;
    --fagni-radius-md: 10px;
    --fagni-radius-lg: 14px;
    --fagni-radius-pill: 999px;

    --fagni-shadow-soft: 0 2px 6px rgba(15,23,42,0.08);
    --fagni-shadow-card: 0 3px 8px rgba(15,23,42,0.12);
}

/* ============================================================
   RESET GLOBAL
   ============================================================ */

body {
    margin: 0;
    padding: 0;
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    background: var(--fagni-bg);
    color: var(--fagni-text);
    -webkit-font-smoothing: antialiased;
}

/* ============================================================
   TITRES + TEXTES
   ============================================================ */

h1, h2, h3, h4 {
    color: var(--fagni-navy);
    margin: 0 0 6px;
}

.page-title {
    font-size: 20px;
    font-weight: 700;
    color: var(--fagni-navy);
}

.page-subtitle {
    font-size: 13px;
    color: var(--fagni-muted);
}

/* ============================================================
   CARTES
   ============================================================ */

.card {
    background: var(--fagni-surface);
    border-radius: var(--fagni-radius-lg);
    padding: 14px;
    border: 1px solid var(--fagni-border);
    box-shadow: var(--fagni-shadow-soft);
    margin-bottom: 14px;
}

/* ============================================================
   BOUTONS
   ============================================================ */

.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 8px 14px;
    border-radius: var(--fagni-radius-md);
    border: none;
    font-size: 14px;
    text-decoration: none;
    cursor: pointer;
    transition: 0.25s ease;
}

.btn-primary {
    background: var(--fagni-primary);
    color: #fff;
}

.btn-primary:hover {
    background: var(--fagni-primary-hover);
}

.btn-secondary {
    background: var(--fagni-navy);
    color: #fff;
}

.btn-light {
    background: var(--fagni-bg);
    border: 1px solid var(--fagni-border);
    color: var(--fagni-text);
}

.btn-pill {
    border-radius: var(--fagni-radius-pill);
}

/* ============================================================
   BADGES (Statuts commande)
   ============================================================ */

.badge-status {
    font-size: 11px;
    padding: 4px 8px;
    font-weight: 600;
    border-radius: var(--fagni-radius-pill);
    border: 1px solid transparent;
    display: inline-block;
}

.badge-status--pending {
    background: #fef3c7;
    color: #92400e;
    border-color: #fde68a;
}

.badge-status--in_progress {
    background: #dbeafe;
    color: #1d4ed8;
    border-color: #bfdbfe;
}

.badge-status--done {
    background: #dcfce7;
    color: #166534;
    border-color: #bbf7d0;
}

.badge-status--canceled {
    background: #fee2e2;
    color: #b91c1c;
    border-color: #fecaca;
}

/* ============================================================
   CHIP BUTTONS (Boutons rapides dans Hub, Me…)
   ============================================================ */

.chip-button {
    font-size: 12px;
    padding: 6px 10px;
    border-radius: var(--fagni-radius-pill);
    background: #f1f5f9;
    border: 1px solid var(--fagni-border);
    color: var(--fagni-text);
    text-decoration: none;
    transition: 0.2s;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1.2;
    gap: 4px;
}

.chip-button--primary {
    background: var(--fagni-primary);
    border-color: var(--fagni-primary);
    color: #fff;
}

.chip-button--ghost {
    background: #fff;
}

/* ============================================================
   KPI CARDS
   ============================================================ */

.kpi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 12px;
}

.kpi-card {
    background: #fff;
    padding: 12px;
    border-radius: var(--fagni-radius-lg);
    border-left: 4px solid transparent;
    border: 1px solid var(--fagni-border);
    box-shadow: var(--fagni-shadow-soft);
}

.kpi-card__label {
    font-size: 11px;
    color: var(--fagni-muted);
    text-transform: uppercase;
    font-weight: 600;
}

.kpi-card__value {
    font-size: 22px;
    font-weight: 700;
    margin-top: 4px;
    display: flex;
    align-items: baseline;
}

.kpi-card__sub {
    font-size: 12px;
    color: var(--fagni-text-soft);
}

.kpi-card--primary { border-left-color: var(--fagni-navy); }
.kpi-card--orange  { border-left-color: var(--fagni-primary); }
.kpi-card--blue    { border-left-color: #0ea5e9; }
.kpi-card--green   { border-left-color: var(--fagni-success); }

/* ============================================================
   NAVBAR LIVREUR — version mobile
   ============================================================ */

.driver-bottom-nav {
    position: fixed;
    bottom: 0;
    left: 0; right: 0;
    height: 58px;
    background: #fff;
    border-top: 1px solid var(--fagni-border);
    display: flex;
    justify-content: space-around;
    align-items: center;
    z-index: 50;
}

.driver-bottom-nav__item {
    flex: 1;
    text-align: center;
    color: var(--fagni-muted);
    text-decoration: none;
    font-size: 11px;
}

.driver-bottom-nav__item--active {
    color: var(--fagni-primary);
    font-weight: 700;
}

/* ============================================================
   FORMULAIRES (nouvelle commande, filtrage…)
   ============================================================ */

input, select, textarea {
    width: 100%;
    padding: 10px;
    border-radius: var(--fagni-radius-md);
    border: 1px solid var(--fagni-border);
    background: #fff;
    margin-bottom: 10px;
}

/* ============================================================
   UTILITIES
   ============================================================ */

.shadow-soft { box-shadow: var(--fagni-shadow-soft); }
.shadow-card { box-shadow: var(--fagni-shadow-card); }

.radius { border-radius: var(--fagni-radius-md); }
.radius-lg { border-radius: var(--fagni-radius-lg); }
.radius-pill { border-radius: var(--fagni-radius-pill); } 

/* ============================================================
   DARK HEADER — VARIANTE C (code + statut)
   ============================================================ */

/* Bandeau sombre pour les entêtes de cartes commandes :
   - driver_me (driver-order-header)
   - driver_app (order-card__header, si utilisé)
   - mini-cartes du hub (mini-order__main)
*/
.driver-order-header,
.order-card__header,
.mini-order__main {
    background: #020617;                  /* Noir bleuté profond */
    color: #f9fafb;
    padding: 8px 12px;
    border-radius: var(--fagni-radius-lg) var(--fagni-radius-lg) 0 0;
    margin: -10px -12px 6px;              /* "remonte" le header pour coller aux bords */
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
}

/* Code commande dans ces headers */
.driver-order-code,
.order-code,
.mini-order__code {
    color: #f9fafb;
}

/* Statuts dans header sombre (badge-status / mini-order__badge) */
.driver-order-header .badge-status,
.order-card__header .badge-status,
.mini-order__main .mini-order__badge {
    border-color: rgba(148,163,184,0.7);
}

/* On évite que le reste de la carte soit trop collé au header */
.driver-order-body,
.order-card__body,
.mini-order__meta {
    margin-top: 2px;
}
