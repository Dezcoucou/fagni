{% extends "admin/base_site.html" %}

{% block content %}
<h1>💳 Paiements à vérifier</h1>

<table border="1" cellpadding="10" cellspacing="0" style="width:100%;background:white;">
  <tr>
    <th>Commande</th>
    <th>Client</th>
    <th>Montant</th>
    <th>Référence</th>
    <th>Preuve</th>
    <th>Date</th>
    <th>Actions</th>
  </tr>

  {% for o in orders %}
  <tr>
    <td><strong>{{ o.code }}</strong></td>
    <td>{{ o.customer }}</td>
    <td><strong>{{ o.total_client_ttc }} FCFA</strong></td>
    <td>{{ o.payment_declared_reference|default:"—" }}</td>
    <td>
      {% if o.payment_proof %}
        <a href="{{ o.payment_proof.url }}" target="_blank">Voir preuve</a>
      {% else %}
        —
      {% endif %}
    </td>
    <td>{{ o.payment_declared_at|default:"—" }}</td>
    <td style="display:flex;gap:8px;align-items:center;">
      <a href="/admin/orders/order/{{ o.id }}/change/">Voir</a>

      <form method="post" action="{% url 'orders:admin_payment_review_confirm' o.id %}" style="display:inline;">
        {% csrf_token %}
        <button type="submit" style="background:#16a34a;color:white;border:0;padding:8px 12px;border-radius:8px;cursor:pointer;">
          Valider
        </button>
      </form>

      <form method="post" action="{% url 'orders:admin_payment_review_reject' o.id %}" style="display:inline;">
        {% csrf_token %}
        <button type="submit" style="background:#dc2626;color:white;border:0;padding:8px 12px;border-radius:8px;cursor:pointer;">
          Rejeter
        </button>
      </form>
    </td>
  </tr>
  {% empty %}
  <tr>
    <td colspan="7">Aucun paiement en attente</td>
  </tr>
  {% endfor %}
</table>
{% endblock %}
