{% extends "base.html" %}

{% block content %}
<div class="page-header">
    <div class="page-header__left">
        <h1 class="page-title">Mon wallet livreur</h1>
        <p class="page-subtitle">
            Suivi de tes revenus FAGNI (livraisons) et de ton solde disponible.
        </p>
    </div>
    <div class="page-header__right">
        <a href="{% url 'orders:driver_app' %}{% if request.GET.urlencode %}?{{ request.GET.urlencode }}{% endif %}" class="btn btn-light">
            ← Retour à mes courses
        </a>
    </div>
</div>

<div class="container">
    {% if error_message %}
        <div class="alert alert-warning">
            {{ error_message }}
        </div>
    {% else %}

        <!-- Carte solde + résumé + demande de retrait -->
        <div class="card mb-4">
            <div class="card-body wallet-header d-flex justify-content-between align-items-center flex-wrap">

                <!-- Bloc solde & résumé -->
                <div class="wallet-main mb-3 mb-md-0">
                    <h2 class="wallet-balance-label h6 text-muted mb-1">Solde disponible</h2>
                    <div class="wallet-balance-amount h3 mb-1">
                        {{ wallet.balance|default:"0" }} {{ wallet.currency|default:"XOF" }}
                    </div>
                    <div class="wallet-owner text-muted">
                        Livreur&nbsp;: <strong>{{ driver.name }}</strong>
                    </div>

                    <div class="wallet-month-summary mt-3">
                        <p class="mb-1 text-muted">
                            Gains sur le mois en cours :
                        </p>
                        <p class="h5 mb-0">
                            {{ month_earnings|default:"0" }} {{ wallet.currency|default:"XOF" }}
                        </p>
                        <small class="text-muted">
                            Période depuis le {{ month_start|date:"d/m/Y" }}
                        </small>
                    </div>
                </div>

                <!-- Formulaire de demande de retrait -->
                <div class="wallet-actions text-md-end">
                    <form method="post"
                          class="wallet-withdraw-form"
                          action="{% url 'wallets:driver_wallet_dashboard' %}?driver_id={{ driver.id }}">
                        {% csrf_token %}
                        <div class="mb-2">
                            <label for="id_amount" class="form-label small">
                                Montant à retirer (FCFA)
                            </label>
                            <input
                                type="number"
                                name="amount"
                                id="id_amount"
                                class="form-control form-control-sm"
                                min="1"
                                step="1"
                                max="{{ wallet.balance|default:'0' }}"
                                value="{{ wallet.balance|default:'0' }}"
                            >
                        </div>
                        <button type="submit" class="btn btn-primary btn-sm w-100">
                            💸 Demander un paiement
                        </button>
                        <p class="text-muted small mt-1 mb-0">
                            La demande sera vérifiée et validée par l’équipe FAGNI.
                        </p>
                    </form>
                </div>
            </div>
        </div>

        <!-- Demandes de retrait -->
        <div class="card mb-4">
            <div class="card-body">
                <h2 class="card-title h5 mb-3">Mes demandes de retrait</h2>

                {% if pending_withdrawals %}
                    <p class="small mb-2">
                        <strong>Demandes en attente :</strong>
                    </p>
                    <ul class="list-unstyled mb-3">
                        {% for wr in pending_withdrawals %}
                            <li class="mb-1">
                                • {{ wr.created_at|date:"d/m/Y H:i" }} –
                                {{ wr.amount }} {{ wallet.currency|default:"XOF" }}
                                <span class="badge bg-warning text-dark ms-1">En attente</span>
                            </li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <p class="text-muted small mb-3">
                        Aucune demande en attente pour le moment.
                    </p>
                {% endif %}

                <h3 class="h6 mt-3">Historique des demandes</h3>
                {% if last_withdrawals %}
                    <div class="table-responsive mt-2">
                        <table class="table table-sm align-middle">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th class="text-end">Montant</th>
                                    <th>Statut</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for wr in last_withdrawals %}
                                    <tr>
                                        <td>{{ wr.created_at|date:"d/m/Y H:i" }}</td>
                                        <td class="text-end">
                                            {{ wr.amount }} {{ wallet.currency|default:"XOF" }}
                                        </td>
                                        <td>
                                            {% if wr.status == "pending" %}
                                                <span class="badge bg-warning text-dark">En attente</span>
                                            {% elif wr.status == "approved" %}
                                                <span class="badge bg-info text-dark">Approuvée</span>
                                            {% elif wr.status == "paid" %}
                                                <span class="badge bg-success">Payée</span>
                                            {% else %}
                                                <span class="badge bg-danger">Rejetée</span>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <p class="text-muted small mb-0">
                        Aucune demande de retrait enregistrée pour l’instant.
                    </p>
                {% endif %}
            </div>
        </div>

        <!-- Liste des transactions -->
        <div class="card">
            <div class="card-body">
                <h2 class="card-title h5 mb-3">Derniers mouvements</h2>

                {% if transactions %}
                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Type</th>
                                    <th>Sens</th>
                                    <th class="text-end">Montant</th>
                                    <th>Description</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for tx in transactions %}
                                    <tr>
                                        <td>{{ tx.created_at|date:"d/m/Y H:i" }}</td>
                                        <td>{{ tx.get_type_display|default:tx.type }}</td>
                                        <td>
                                            {% if tx.direction == "in" %}
                                                <span class="badge bg-success">Entrant</span>
                                            {% else %}
                                                <span class="badge bg-danger">Sortant</span>
                                            {% endif %}
                                        </td>
                                        <td class="text-end">
                                            {% if tx.direction == "out" %}-{% endif %}
                                            {{ tx.amount }} {{ wallet.currency|default:"XOF" }}
                                        </td>
                                        <td>{{ tx.description|default:"—" }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <p class="text-muted mb-0">
                        Aucune transaction pour le moment sur ton wallet.
                    </p>
                {% endif %}
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}
